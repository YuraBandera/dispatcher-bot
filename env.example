# Скопіюй цей файл у .env і заповни реальними значеннями.
# На Railway .env не потрібен — ці ж змінні додаєш у вкладці Variables.

DISCORD_TOKEN=твій_discord_токен
GEMINI_API_KEY=твій_gemini_ключ

# ID каналів та ролі (увімкни Developer Mode у Discord, клік ПКМ → Copy ID)
CALLS_CHANNEL_ID=000000000000000000
FACTION_CHANNEL_ID=000000000000000000
ROLE_ID_TO_PING=000000000000000000

# За потреби постав новішу flash-модель, доступну на твоєму ключі
GEMINI_MODEL=gemini-2.5-flash
